# Spacemail SMTP — add these in Vercel → Settings → Environment Variables
# Official Spacemail outgoing server is mail.spacemail.com (not smtp.spacemail.com)
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_USER=hello@cafebernarda.co.uk
SMTP_PASS=your-mailbox-password
ENQUIRY_TO=hello@cafebernarda.co.uk
